# Billiard Poker build configuration.
# Values are passed at build time, e.g.:
#   flutter run --dart-define-from-file=.env
# Only PUBLIC identifiers belong here. Never put the Cloudinary API secret or a
# Firebase service-account key in this file or anywhere in the app.

# Address of the PHP backend (backend/), no trailing slash.
# Empty: the app is offline only (bots and pass & play).
API_BASE_URL=

# Optional TLS leaf cert SHA-256 (hex). Leave empty for normal HTTPS trust.
API_CERT_SHA256=

# Cloudinary (leave empty in demo: bundled avatars are used, upload is disabled)
CLOUDINARY_CLOUD_NAME=
# UNSIGNED upload preset, restricted to images and to the folder below
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_FOLDER=billiard_poker

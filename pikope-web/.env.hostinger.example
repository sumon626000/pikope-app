# Copy to pikope-web/.env.hostinger (gitignored). hPanel → Files → FTP Accounts.
# Main domain ONLY — do not point this at public_html/pikope (that is adminnew API).

WEB_FTP_HOST=ftp.pikope.com
WEB_FTP_USER=u123456789
WEB_FTP_PASS=your_ftp_password
# Usually /public_html or /domains/pikope.com/public_html (see FTP account “Directory” in hPanel)
WEB_FTP_REMOTE=/public_html

# Copy to .env and fill in. Never commit .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=billiard_poker
DB_USER=billiard_poker
DB_PASS=change-me

# Public base URL of this API (used to build avatar URLs), no trailing slash.
APP_URL=https://api.example.com

# Browser CORS origin. Leave empty for mobile-only (no CORS headers). Never use * in production.
CORS_ORIGIN=

TOKEN_TTL_DAYS=90

# Live play over WebSockets (bin/ws-server.php). WS_PUBLIC_URL is the address
# the app connects to - normally wss://your-domain/ws through the web server.
# Leave WS_PUBLIC_URL empty if the host cannot run the WebSocket server: the
# app then plays over HTTP (polling), which works everywhere.
WS_HOST=127.0.0.1
WS_PORT=8081
WS_PUBLIC_URL=

# Forgot-password SMS OTP (sign-up has no OTP). Configure delivery in admin → SMS OTP.
# Optional: append OTPs to this file (overrides admin delivery; used by tests/api_flow.php).
SMS_LOG=

# Legacy mail settings (not used for player login).
MAIL_FROM=no-reply@example.com
# Send through a mailbox on your domain (recommended; mail() often lands in
# spam or is not available). Port 465 = TLS, 587 = STARTTLS. Leave SMTP_HOST
# empty to use PHP's mail(). MAIL_FROM should be the mailbox itself.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Development only: write emails to this file instead of sending them.
MAIL_LOG=

# Firebase Cloud Messaging server key (APK push from admin → Push). Legacy server key
# from Firebase console → Project settings → Cloud Messaging. Leave empty to use
# in-app inbox only (no device push until set).
FCM_SERVER_KEY=

# Admin page at /admin (HTTP Basic). Leave both empty to switch it off.
ADMIN_USER=
ADMIN_PASS=
# Optional: only these IPs may open /admin (comma-separated). Empty = any IP.
ADMIN_IP_ALLOWLIST=

# Shot history kept for audits, in days.
SHOT_LOG_DAYS=30

# 1 shows error details in responses. Keep 0 in production.
APP_DEBUG=0
# 1 enables scripted shots for the API tests. NEVER in production.
APP_TEST_HOOKS=0
# Multiplies every rate limit (tests create many accounts from one address).
RATE_LIMIT_FACTOR=1
